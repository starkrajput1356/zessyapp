{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/news-sitemap.xml",
      "destination": "https://zetsy.runasp.net/api/news/news-sitemap.xml"
    },
    {
      "source": "/news-articles-sitemap.xml",
      "destination": "https://zetsy.runasp.net/api/news/sitemap.xml"
    },
    {
      "source": "/news/feed.xml",
      "destination": "https://zetsy.runasp.net/api/news/feed.xml"
    },
    {
      "source": "/de876a26fce64d7aab3bf728e8849649.txt",
      "destination": "https://zetsy.runasp.net/api/news/indexnow-key.txt"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/news-sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=600, s-maxage=600" }
      ]
    },
    {
      "source": "/news-articles-sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=1800, s-maxage=1800" }
      ]
    },
    {
      "source": "/news/feed.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/rss+xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=900, s-maxage=900" }
      ]
    },
    {
      "source": "/de876a26fce64d7aab3bf728e8849649.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    }
  ]
}
